{
  "name": "@musira/musira",
  "version": "1.0.0",
  "private": "true",
  "description": "",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "generate-ssl": "./scripts/generate-ssl-certs.sh",
    "start:backend": "cd packages/backend && npm start",
    "start:backend:debug": "cd packages/backend && npm run start:debug",
    "start:frontend": "cd packages/frontend && npm start",
    "start": "concurrently -k -s first -n backend,frontend -c \"yellow,blue\" \"npm run start:backend\" \"npm run start:frontend\"",
    "e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuentinLemCode/musira.git"
  },
  "author": "QuentinLemCode",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/QuentinLemCode/musira/issues"
  },
  "homepage": "https://github.com/QuentinLemCode/musira#readme",
  "workspaces": [
    "packages/backend",
    "packages/api",
    "packages/frontend"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@playwright/test": "^1.47.2"
  }
}
