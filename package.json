{
  "name": "@musira/musira",
  "version": "1.0.0",
  "private": "true",
  "description": "",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "format:check": "npx prettier --check .",
    "generate-ssl": "./scripts/generate-ssl-certs.sh",
    "start:backend": "cd packages/backend && npm start",
    "start:backend:debug": "cd packages/backend && npm run start:debug",
    "start:frontend": "cd packages/frontend && npm start",
    "start": "concurrently -k -s first -n backend,frontend -c \"yellow,blue\" \"npm run start:backend\" \"npm run start:frontend\"",
    "e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ci:lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuentinLemCode/musira.git"
  },
  "author": "QuentinLemCode",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/QuentinLemCode/musira/issues"
  },
  "homepage": "https://github.com/QuentinLemCode/musira#readme",
  "workspaces": [
    "packages/backend",
    "packages/api",
    "packages/frontend"
  ],
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^20.1.1",
    "@angular-eslint/eslint-plugin-template": "^20.1.1",
    "@angular-eslint/template-parser": "^20.1.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.47.2",
    "@stylistic/eslint-plugin": "^2.13.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.39.0"
  }
}
