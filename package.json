{
  "private": true,
  "name": "musira",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many --projects=api,musira -t build",
    "build:api:prod": "nx run api:build --configuration=production",
    "build:front:prod": "nx run musira:build --configuration=production",
    "build:prod": "nx run-many --projects=api,musira -t build --configuration=production",
    "build:watch": "tsc -p apps/api/tsconfig.debug.json && (concurrently \"tsc -p apps/api/tsconfig.debug.json -w\" \"tsc-alias -p apps/api/tsconfig.debug.json -w\")",
    "e2e": "nx e2e musira-e2e --watch",
    "format": "prettier -w ./",
    "format:check": "prettier -c ./",
    "postinstall": "node ./decorate-angular-cli.js",
    "lint": "eslint --fix",
    "ng": "nx",
    "prepare": "husky install",
    "serve:api": "nx serve api",
    "serve:front": "nx serve musira",
    "start": "nx run-many --target=serve --projects=api,musira --parallel=2",
    "test:api": "nx test api",
    "test:front": "nx test",
    "tsc-alias": "tsc-alias -p apps/api/tsconfig.debug.json -w"
  },
  "dependencies": {
