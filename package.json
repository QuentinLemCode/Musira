{
  "name": "@musira/musira",
  "version": "1.0.0",
  "private": "true",
  "description": "",
  "scripts": {
    "test": "npm run test --workspaces --if-present --silent",
    "format:check": "npx prettier --check .",
    "format:write": "npx prettier --write .",
    "generate-ssl": "./scripts/generate-ssl-certs.sh",
    "start:backend": "cd packages/backend && npm start",
    "start:backend:debug": "cd packages/backend && npm run start:debug",
    "start:frontend": "cd packages/frontend && npm run start",
    "start:frontend:debug": "cd packages/frontend && npm run start:dev",
    "build:backend": "cd packages/backend && npm run build",
    "build:frontend": "cd packages/frontend && npm run build",
    "build:frontend:prod": "cd packages/frontend && npm run build:prod",
    "start": "concurrently -k -s first -n backend,frontend -c \"yellow,blue\" \"npm run start:backend\" \"npm run start:frontend\"",
    "e2e": "playwright test --reporter=line",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ci:lint": "eslint .",
    "openapi": "cd packages/backend && npm run openapi",
    "openapi:fetch": "curl -k https://localhost:3020/openapi.json -o packages/backend/openapi.json",
    "api:generate": "cd packages/frontend && npx -y @openapitools/openapi-generator-cli generate -i ../backend/openapi.json -g typescript-angular -o src/generated --additional-properties=ngVersion=20,providedIn=root,npmName=@musira/client,withSeparateModelsAndApi=true,apiModulePrefix=Musira,serviceSuffix=Service,enumPropertyNaming=original",
    "api:watch": "npx -y chokidar-cli \"packages/backend/openapi.json\" -c \"npm run api:generate\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuentinLemCode/musira.git"
  },
  "author": "QuentinLemCode",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/QuentinLemCode/musira/issues"
  },
  "homepage": "https://github.com/QuentinLemCode/musira#readme",
  "workspaces": [
    "packages/backend",
    "packages/frontend",
    "packages/infra"
  ],
  "devDependencies": {
    "typescript": "~5.8.2",
    "@angular-eslint/eslint-plugin": "^20.1.1",
    "@angular-eslint/eslint-plugin-template": "^20.1.1",
    "@angular-eslint/template-parser": "^20.1.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.59.1",
    "@stylistic/eslint-plugin": "^2.13.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.59.2"
  }
}
