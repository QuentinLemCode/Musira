FROM node:24-alpine AS base

ENV TZ=Europe/Paris
WORKDIR /app

# ----------------------------------------
# Install backend workspace deps and build
# ----------------------------------------
FROM base AS build
RUN apk add --no-cache --virtual .build-deps python3 make g++

# Copy only root manifests and backend manifest to leverage npm workspaces
COPY package.json package-lock.json ./
COPY packages/backend/package.json packages/backend/package.json

# Install only the backend workspace dependencies (dev deps included for build)
RUN npm ci -w @musira/backend

# Copy backend sources and configs
COPY packages/backend/tsconfig*.json packages/backend/nest-cli.json packages/backend/
COPY packages/backend/src packages/backend/src

# Build backend and then prune dev dependencies for backend workspace
RUN npm run -w @musira/backend build \
  && npm prune -w @musira/backend --omit=dev \
  && apk del .build-deps

# ----------------------------------------
# Runtime image
# ----------------------------------------
FROM node:24-alpine AS runtime

ENV NODE_ENV=production
ENV TZ=Europe/Paris
WORKDIR /app/packages/backend

# Minimal init to handle signals properly
RUN apk add --no-cache dumb-init

# Copy only what is needed to run backend
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/packages/backend/dist ./dist

USER node
EXPOSE 3020
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main.js"]


