{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["jest", "node", "@fastify/cookie/types/plugin.d.ts"],
    "verbatimModuleSyntax": false
  },
  "include": [
    "jest.config.ts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.d.ts",
    "setup-jest.js",
    "src/test-utils/*.ts",
    "@fastify/cookie/types/plugin.d.ts"
  ]
}
