{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["jest", "node"],
    "verbatimModuleSyntax": false
  },
  "include": [
    "jest.config.ts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.d.ts",
    "../../libs/api-interfaces/src/*",
    "setup-jest.js",
    "src/test/mock.ts",
    "test/*.ts"
  ]
}
