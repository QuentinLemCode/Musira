{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "ES2022",
    "moduleResolution": "Node",
    "types": ["node"],
    "target": "es2021",
    "sourceMap": true
  },
  "exclude": [
    "jest.config.ts",
    "**/*.spec.ts",
    "**/*.test.ts",
    "src/test-utils/*.ts"
  ],
  "include": ["**/*.ts", "setup-jest.js", "global.d.ts"]
}
