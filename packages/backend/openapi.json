  "info": {
    "title": "Musira API",
    "description": "OpenAPI specification for all Musira backend routes",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "MusicDto": {
        "type": "object",
        "properties": {
          "artist": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "album": {
            "type": "string"
          },
          "uri": {
            "type": "string",
            "description": "Spotify track URI"
          },
          "cover": {
            "type": "string",
            "description": "Cover image URL"
          },
          "duration": {
            "type": "number"
          }
        },
        "required": [
          "artist",
          "title",
          "album",
          "uri",
          "duration"
        ]
      },
      "UserLightDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "QueueDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "status": {
            "type": "number",
            "enum": [
              0,
              1,
              2,
              3
            ],
            "description": "0=PENDING, 1=PLAYING, 2=FINISHED, 3=CANCELLED"
          },
          "music": {
            "$ref": "#/components/schemas/MusicDto"
          },
          "user": {
            "$ref": "#/components/schemas/UserLightDto"
          },
          "forward_votes": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "status",
          "music",
          "user",
          "forward_votes"
        ]
      },
      "CurrentMusicDto": {
        "type": "object",
        "properties": {
          "isSpotifyAccountRegistered": {
            "type": "boolean"
          },
          "currentPlay": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/MusicDto"
              }
            ]
          },
          "queue": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueueDto"
            }
          },
          "engineStarted": {
            "type": "boolean"
          },
          "message": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "isSpotifyAccountRegistered",
          "engineStarted"
        ]
      },
      "BacklogDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "music": {
            "$ref": "#/components/schemas/MusicDto"
          }
        },
        "required": [
          "id",
          "music"
        ]
      },
      "QueueResponseDto": {
        "type": "object",
        "properties": {
          "queue": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueueDto"
            }
          },
          "backlog": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/BacklogDto"
              }
            ]
          }
        },
        "required": [
          "queue",
